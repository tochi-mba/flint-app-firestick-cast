<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The recommended rule set rather than the handful the SDK enables by default. The rules this
         codebase turns off are listed in .editorconfig, each with its reason.

         Pinned to a band rather than `latest-recommended`: every newly recommended rule arrives as
         an error here, so `latest` means a commit that passed can fail tomorrow on a newer SDK with
         no change of its own. The Rust toolchain is pinned for the same reason. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <!-- Generated so the build can report unused usings, which the compiler only tracks when it
         writes documentation. Checked comments must be correct; not every member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Where the file goes is set in Directory.Build.targets: the properties that name it do not
         exist yet here. -->
    <!-- Referenced projects' and packages' documentation stays out of the output too. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Company>REX Technologies</Company>
    <Authors>REX Technologies</Authors>
    <Product>Flint</Product>
    <Copyright>Copyright (c) 2026 REX Technologies</Copyright>
    <!-- VERSION at the repository root is the one version every build reads. -->
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
