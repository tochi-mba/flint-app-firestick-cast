<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flint.App.ViewModels"
             xmlns:controls="using:Flint.App.Controls"
             x:Class="Flint.App.Views.SettingsPage"
             x:DataType="vm:CastPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="{StaticResource PageMargin}" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
      <controls:PageHeading Eyebrow="Local preferences" Title="Settings" Trailing="" TrailingTone="Neutral" />
      <controls:InfoCard>
        <StackPanel Spacing="12">
          <TextBlock Theme="{StaticResource TitleMedium}" Text="Remembered TVs" />
          <ItemsControl ItemsSource="{Binding RecentAddresses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Theme="{StaticResource BodyMedium}" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}" Text="Direct addresses are retained only on this PC." />
          <Button Theme="{StaticResource OutlineAction}" HorizontalAlignment="Left" Command="{Binding ClearRecentAddressesCommand}" Content="CLEAR REMEMBERED TVS" />
        </StackPanel>
      </controls:InfoCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>