<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27 introduced windowLightNavigationBar, so keep it out of the API 26 base theme. -->
    <style name="Theme.FlintMobile" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
