<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Flint is standalone. Clear inherited feeds so the build never depends on a private
       corporate source that is unrelated to this project. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
