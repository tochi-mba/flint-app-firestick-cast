<Project>

  <!--
    Every NuGet version in the solution, in one place. A project names the packages it uses and never
    their versions, so two projects cannot drift onto different releases of the same package.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version listed here also pins that package wherever it arrives transitively. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="The Windows app">
    <PackageVersion Include="Avalonia" Version="11.3.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!--
      The installer and the update client. The same version as the vpk tool in
      .config/dotnet-tools.json, which builds the packages this library reads: a client older than
      the packages cannot apply them.
    -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <!--
      No project references this directly. Avalonia.Desktop pulls in a Tmds.DBus.Protocol with a
      published advisory (GHSA-xrw6-gwf8-vvr9). The D-Bus path is Linux-only and never executes on a
      Windows host, but a known-vulnerable package does not belong in the graph, so the transitive
      version is pinned here.
    -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
  </ItemGroup>

</Project>
