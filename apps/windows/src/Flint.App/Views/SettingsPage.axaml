<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flint.App.ViewModels"
             xmlns:settings="using:Flint.App.ViewModels.Settings"
             xmlns:views="using:Flint.App.Views"
             xmlns:controls="using:Flint.App.Controls"
             x:Class="Flint.App.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type settings:GeneralSettingsViewModel}"><views:GeneralSettingsSection /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:MediaSettingsViewModel}"><views:MediaSettingsSection /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:ScreenSettingsViewModel}"><views:ScreenSettingsSection /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:TvSettingsViewModel}"><views:TvSettingsSection /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:PrivacySettingsViewModel}"><views:PrivacySettingsSection /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:UpdatesSectionViewModel}"><views:UpdatesSettingsSection /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:AboutSettingsViewModel}"><views:AboutSettingsSection /></DataTemplate>
  </UserControl.DataTemplates>

  <Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,18">
      <controls:PageHeading Eyebrow="Local preferences" Title="Settings" Trailing="APPLIES AT ONCE" TrailingTone="Signal" />
      <TextBox x:Name="SettingsSearch" Theme="{StaticResource FlintTextBox}"
               Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search settings"
               AutomationProperties.Name="Search settings" />
    </StackPanel>

    <Grid x:Name="SectionLayout" Grid.Row="1" ColumnDefinitions="180,*" RowDefinitions="*">
      <ListBox x:Name="SectionList" Grid.Column="0" Margin="0,0,20,0"
               ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0"
               AutomationProperties.Name="Settings sections">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="settings:SettingsSectionViewModel">
            <TextBlock Theme="{StaticResource TitleMedium}" Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer x:Name="SectionScroller" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="720" HorizontalAlignment="Left">
          <ContentControl Content="{Binding SelectedSection}" IsVisible="{Binding !IsSearching}" />
          <StackPanel IsVisible="{Binding IsSearching}" Spacing="10">
            <TextBlock Theme="{StaticResource HeadlineLarge}" Text="Search results" />
            <ItemsControl ItemsSource="{Binding SearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settings:SettingSearchResult">
                  <Button Theme="{StaticResource ContentOutlineButton}" MinHeight="58"
                          Margin="0,0,0,8" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).OpenResultCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="{Binding Setting.Title}">
                    <StackPanel HorizontalAlignment="Left">
                      <TextBlock Theme="{StaticResource LabelSmall}" Text="{Binding SectionTitle}" />
                      <TextBlock Theme="{StaticResource TitleMedium}" Text="{Binding Setting.Title}" />
                      <TextBlock Theme="{StaticResource BodySmall}" Text="{Binding Setting.Description}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:EmptyState IsVisible="{Binding HasNoResults}" Glyph="?"
                                 Title="No settings found" Body="{Binding NoResultsText}" />
            <Button Theme="{StaticResource OutlineAction}" HorizontalAlignment="Left"
                    Content="CLEAR SEARCH" Command="{Binding ClearSearchCommand}"
                    AutomationProperties.Name="Clear search" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
