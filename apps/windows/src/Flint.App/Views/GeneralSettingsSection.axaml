<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Flint.App.Controls"
             xmlns:settings="using:Flint.App.ViewModels.Settings"
             xmlns:views="using:Flint.App.Views"
             x:Class="Flint.App.Views.GeneralSettingsSection"
             x:DataType="settings:GeneralSettingsViewModel">
  <StackPanel Spacing="0">
    <TextBlock Theme="{StaticResource HeadlineLarge}" Text="General" Margin="0,0,0,10" />
    <controls:SettingRow Title="{Binding AskBeforeSwitchingText.Title}"
                         Description="{Binding AskBeforeSwitchingText.Description}">
      <ToggleSwitch x:Name="AskBeforeSwitching"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding AskBeforeSwitching, Mode=TwoWay}"
                    AutomationProperties.Name="Ask before switching what the TV shows" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding KeepAwakeText.Title}"
                         Description="{Binding KeepAwakeText.Description}">
      <ToggleSwitch x:Name="KeepAwake"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding KeepAwake, Mode=TwoWay}"
                    AutomationProperties.Name="Keep this PC awake while sharing or playing" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding InterfaceSizeText.Title}"
                         Description="{Binding InterfaceSizeText.Description}">
      <ComboBox x:Name="InterfaceSize"
                Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding InterfaceScales}"
                SelectedItem="{Binding InterfaceScale, Mode=TwoWay}"
                AutomationProperties.Name="Interface size" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding ReconnectOnStartText.Title}"
                         Description="{Binding ReconnectOnStartText.Description}">
      <ToggleSwitch x:Name="ReconnectOnStart"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding ReconnectOnStart, Mode=TwoWay}"
                    AutomationProperties.Name="Reconnect to the last TV when Flint starts" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding ReconnectAfterDropText.Title}"
                         Description="{Binding ReconnectAfterDropText.Description}">
      <ToggleSwitch x:Name="ReconnectAfterDrop"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding ReconnectAfterDrop, Mode=TwoWay}"
                    AutomationProperties.Name="Keep trying if the connection drops" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding ReconnectTimeText.Title}"
                         Description="{Binding ReconnectTimeText.Description}">
      <ComboBox x:Name="ReconnectTime"
                Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding ReconnectTimeChoices}"
                SelectedItem="{Binding ReconnectTime, Mode=TwoWay}"
                IsEnabled="{Binding ReconnectAfterDrop}"
                AutomationProperties.Name="How long to keep trying" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding AfterReconnectText.Title}"
                         Description="{Binding AfterReconnectText.Description}">
      <ComboBox x:Name="AfterReconnect"
                Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding AfterReconnectChoices}"
                SelectedItem="{Binding AfterReconnect, Mode=TwoWay}"
                AutomationProperties.Name="After reconnecting" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding OpenReceiverText.Title}"
                         Description="{Binding OpenReceiverText.Description}">
      <ToggleSwitch x:Name="OpenReceiverForNewCode"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding OpenReceiverForNewCode, Mode=TwoWay}"
                    AutomationProperties.Name="Open Flint on the TV when a new code is needed" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding ShowTrayIconText.Title}"
                         Description="{Binding ShowTrayIconText.Description}">
      <ToggleSwitch x:Name="ShowTrayIcon"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}"
                    AutomationProperties.Name="Show Flint in the notification area" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding SingleClickText.Title}"
                         Description="{Binding SingleClickText.Description}">
      <ToggleSwitch x:Name="SingleClickOpens"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding SingleClickOpens, Mode=TwoWay}"
                    IsEnabled="{Binding ShowTrayIcon}"
                    AutomationProperties.Name="Open Flint with one click on its icon" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding CloseWindowText.Title}"
                         Description="{Binding CloseWindowText.Description}">
      <StackPanel Spacing="4">
        <ComboBox x:Name="CloseWindow"
                  Theme="{StaticResource FlintComboBox}"
                  ItemsSource="{Binding CloseWindowChoices}"
                  SelectedItem="{Binding CloseWindow, Mode=TwoWay}"
                  IsEnabled="{Binding ShowTrayIcon}"
                  AutomationProperties.Name="When I close the window" />
        <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" MaxWidth="260"
                   Text="{Binding CloseWindowLocked}"
                   IsVisible="{Binding CloseWindowLocked, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding ConfirmQuitText.Title}"
                         Description="{Binding ConfirmQuitText.Description}">
      <ToggleSwitch x:Name="ConfirmQuit"
                    Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding ConfirmQuit, Mode=TwoWay}"
                    AutomationProperties.Name="Ask before quitting while something is on the TV" />
    </controls:SettingRow>
    <StackPanel IsVisible="{Binding CanStartWithWindows}">
      <controls:SettingRow Title="{Binding StartWithWindowsText.Title}"
                           Description="{Binding StartWithWindowsText.Description}">
        <ToggleSwitch x:Name="StartWithWindows"
                      Theme="{StaticResource FlintToggleSwitch}"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                      AutomationProperties.Name="Start Flint when I sign in to Windows" />
      </controls:SettingRow>
      <TextBlock x:Name="StartsFile" Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="{Binding StartsFile}" />
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8"
                  IsVisible="{Binding StaleStart, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Theme="{StaticResource BodySmall}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding StaleStart}" />
        <Button x:Name="StartThisCopy" Theme="{StaticResource OutlineAction}" Content="START THIS COPY"
                Command="{Binding StartThisCopyCommand}"
                AutomationProperties.Name="Start this copy of Flint when I sign in" />
      </StackPanel>
      <controls:SettingRow Title="{Binding StartInTrayText.Title}"
                           Description="{Binding StartInTrayText.Description}">
        <ToggleSwitch x:Name="StartInTray"
                      Theme="{StaticResource FlintToggleSwitch}"
                      IsChecked="{Binding StartInTray, Mode=TwoWay}"
                      IsEnabled="{Binding ShowTrayIcon}"
                      AutomationProperties.Name="Start in the tray" />
      </controls:SettingRow>
    </StackPanel>
    <views:ConfirmableActionView DataContext="{Binding Reset}" Margin="0,18,0,0" />
  </StackPanel>
</UserControl>
