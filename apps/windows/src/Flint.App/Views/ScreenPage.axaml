<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flint.App.ViewModels"
             xmlns:core="using:Flint.Core"
             xmlns:controls="using:Flint.App.Controls"
             xmlns:views="using:Flint.App.Views"
             x:Class="Flint.App.Views.ScreenPage"
             x:DataType="vm:ScreenPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="{StaticResource PageMargin}" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
      <controls:PageHeading Eyebrow="Desktop output" Title="Share your screen"
                            Trailing="{Binding Cast.MirrorVerdict.StatusLabel, FallbackValue=Not probed}"
                            TrailingTone="{Binding Cast.MirrorVerdict.Tone, FallbackValue=Neutral}" />

      <controls:InfoCard BorderTone="{Binding Cast.MirrorVerdict.Tone, FallbackValue=Neutral}">
        <StackPanel Spacing="12">
          <TextBlock Theme="{StaticResource TitleMedium}" Text="Show your desktop on TV" />
          <TextBlock Theme="{StaticResource BodyMedium}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding Cast.MirrorVerdict.Reason, FallbackValue='Connect to your TV from Cast to start sharing.'}" />

          <controls:SectionLabel Text="DISPLAY" />
          <controls:DisplayArrangementPicker x:Name="DisplayMap"
                                             Displays="{Binding Displays}"
                                             SelectedDisplay="{Binding SelectedDisplay, Mode=TwoWay}"
                                             IsVisible="{Binding HasSeveralDisplays}" />
          <TextBlock Theme="{StaticResource BodyMedium}"
                     Text="{Binding SelectedDisplay, Converter={x:Static vm:ScreenPageText.DescribeDisplay}}"
                     IsVisible="{Binding SelectedDisplay, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding MissingDisplayNotice}"
                     IsVisible="{Binding MissingDisplayNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding RotatedDisplayNotice}"
                     IsVisible="{Binding RotatedDisplayNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Spacing="8" IsVisible="{Binding IsChoosingDisplay}">
            <TextBlock Theme="{StaticResource BodyMedium}" Text="Which display should the TV show?" />
            <ItemsControl ItemsSource="{Binding Displays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:DisplayInfo">
                  <Button Theme="{StaticResource ContentOutlineButton}"
                          Content="{Binding Converter={x:Static vm:ScreenPageText.DescribeDisplay}}"
                          Command="{Binding $parent[ItemsControl].((vm:ScreenPageViewModel)DataContext).ShareDisplayCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Converter={x:Static vm:ScreenPageText.DescribeDisplay}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Theme="{StaticResource OutlineAction}" Content="CANCEL" HorizontalAlignment="Left"
                    Command="{Binding CancelChoosingCommand}"
                    AutomationProperties.Name="Close the display chooser" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Theme="{StaticResource SignalButton}" Content="SHARE SCREEN"
                    Command="{Binding ShareCommand}"
                    IsEnabled="{Binding CanShare}"
                    IsVisible="{Binding !Cast.IsMirroring}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Start screen session" />
            <Button Theme="{StaticResource OutlineAction}" Content="STOP SHARING"
                    Command="{Binding Cast.StopScreenSessionCommand}"
                    IsVisible="{Binding Cast.IsMirroring}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Stop screen session" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsCountingDown}">
            <TextBlock Theme="{StaticResource TitleMedium}" VerticalAlignment="Center" Text="{Binding CountdownText}" />
            <Button Theme="{StaticResource OutlineAction}" Content="CANCEL"
                    Command="{Binding CancelCountdownCommand}"
                    AutomationProperties.Name="Cancel sharing" />
          </StackPanel>

          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding SwitchStatus}"
                     IsVisible="{Binding SwitchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding Cast.MirrorStatus}"
                     IsVisible="{Binding Cast.MirrorStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     IsVisible="{Binding Cast.MirrorVerdict.HasRemedy, FallbackValue=False}"
                     Text="{Binding Cast.MirrorVerdict.Remedy}" />
        </StackPanel>
      </controls:InfoCard>

      <controls:InfoCard BorderTone="Signal" IsVisible="{Binding ShowStrugglingSuggestion}">
        <StackPanel Spacing="10">
          <TextBlock Theme="{StaticResource BodyMedium}" Text="The TV is struggling to keep up. Try Data saver." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Theme="{StaticResource SignalButton}" Content="USE DATA SAVER"
                    Command="{Binding UseDataSaverCommand}"
                    AutomationProperties.Name="Switch to Data saver" />
            <Button Theme="{StaticResource OutlineAction}" Content="NOT NOW"
                    Command="{Binding DismissSuggestionCommand}"
                    AutomationProperties.Name="Keep the current picture" />
          </StackPanel>
        </StackPanel>
      </controls:InfoCard>

      <controls:InfoCard>
        <StackPanel Spacing="12">
          <TextBlock Theme="{StaticResource TitleMedium}" Text="Picture" />
          <controls:SegmentedChoice x:Name="PictureModes"
                                    ItemsSource="{Binding PictureModes}"
                                    SelectedItem="{Binding ChosenMode, Mode=TwoWay}"
                                    AutomationProperties.Name="Picture mode" />
          <TextBlock Theme="{StaticResource BodyMedium}" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" Text="{Binding ModeSentence}" />
          <StackPanel Spacing="4" IsVisible="{Binding IsCustom}">
            <controls:SettingRow Title="Largest picture" Description="Never larger than the TV's own screen.">
              <ComboBox x:Name="CustomSize" Theme="{StaticResource FlintComboBox}"
                        ItemsSource="{Binding SizeLimits}"
                        SelectedItem="{Binding CustomSizeLimit, Mode=TwoWay}"
                        AutomationProperties.Name="Largest picture" />
            </controls:SettingRow>
            <controls:SettingRow Title="Frames a second" Description="More is smoother and uses more data.">
              <ComboBox x:Name="CustomFrames" Theme="{StaticResource FlintComboBox}"
                        ItemsSource="{Binding FrameRates}"
                        SelectedItem="{Binding CustomFrameRate, Mode=TwoWay}"
                        AutomationProperties.Name="Frames a second" />
            </controls:SettingRow>
            <controls:SettingRow Title="Data rate" Description="Lower suits weak Wi-Fi; higher gives a cleaner picture.">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Slider x:Name="CustomRate" Theme="{StaticResource FlintSlider}" Width="200"
                        Minimum="{x:Static vm:ScreenPageText.MinimumMegabits}"
                        Maximum="{x:Static vm:ScreenPageText.MaximumMegabits}"
                        SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CustomMegabits, Mode=TwoWay}"
                        AutomationProperties.Name="Data rate in megabits a second" />
                <TextBlock Theme="{StaticResource BodyMedium}" VerticalAlignment="Center"
                           Text="{Binding CustomMegabits, StringFormat='{}{0:0} Mbps'}" />
              </StackPanel>
            </controls:SettingRow>
          </StackPanel>
        </StackPanel>
      </controls:InfoCard>

      <controls:InfoCard>
        <StackPanel Spacing="10">
          <controls:SettingRow Title="Live numbers" Description="What the share is sending, while it runs.">
            <ToggleSwitch x:Name="LiveNumbers" Theme="{StaticResource FlintToggleSwitch}"
                          IsChecked="{Binding ShowLiveNumbers, Mode=TwoWay}"
                          AutomationProperties.Name="Show live numbers" />
          </controls:SettingRow>
          <views:LiveNumbersView IsVisible="{Binding ShowLiveNumbers}" />
        </StackPanel>
      </controls:InfoCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
