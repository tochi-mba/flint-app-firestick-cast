<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flint.App.ViewModels"
             xmlns:controls="using:Flint.App.Controls"
             x:Class="Flint.App.Views.ScreenPage"
             x:DataType="vm:CastPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="{StaticResource PageMargin}" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
      <controls:PageHeading Eyebrow="Desktop output" Title="Screen"
                            Trailing="{Binding MirrorVerdict.StatusLabel, FallbackValue=Not probed}"
                            TrailingTone="{Binding MirrorVerdict.Tone, FallbackValue=Neutral}" />

      <controls:InfoCard BorderTone="{Binding MirrorVerdict.Tone, FallbackValue=Neutral}">
        <StackPanel Spacing="12">
          <TextBlock Theme="{StaticResource TitleMedium}" Text="Send your desktop to the connected TV" />
          <TextBlock Theme="{StaticResource BodyMedium}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding MirrorVerdict.Reason, FallbackValue='Probe the network from Cast first.'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Theme="{StaticResource SignalButton}" Content="START SCREEN SESSION"
                    Command="{Binding StartScreenSessionCommand}"
                    IsEnabled="{Binding MirrorVerdict.IsOfferable, FallbackValue=False}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Start screen session" />
            <Button Theme="{StaticResource OutlineAction}" Content="STOP"
                    Command="{Binding StopScreenSessionCommand}"
                    IsVisible="{Binding IsMirroring}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Stop screen session" />
          </StackPanel>
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     Text="{Binding MirrorStatus}"
                     IsVisible="{Binding MirrorStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Theme="{StaticResource BodySmall}" Foreground="{StaticResource MutedBrush}"
                     IsVisible="{Binding MirrorVerdict.HasRemedy, FallbackValue=False}"
                     Text="{Binding MirrorVerdict.Remedy}" />
        </StackPanel>
      </controls:InfoCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
