<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Flint.App.Controls"
             xmlns:settings="using:Flint.App.ViewModels.Settings"
             xmlns:views="using:Flint.App.Views"
             x:Class="Flint.App.Views.MediaSettingsSection"
             x:DataType="settings:MediaSettingsViewModel">
  <StackPanel Spacing="0">
    <TextBlock Theme="{StaticResource HeadlineLarge}" Text="Media" Margin="0,0,0,10" />
    <controls:SettingRow Title="{Binding SkipBackText.Title}"
                         Description="{Binding SkipBackText.Description}">
      <ComboBox x:Name="SkipBack"
                Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding SkipBackChoices}"
                SelectedItem="{Binding SkipBack, Mode=TwoWay}"
                AutomationProperties.Name="Skip back by" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding SkipForwardText.Title}"
                         Description="{Binding SkipForwardText.Description}">
      <ComboBox x:Name="SkipForward"
                Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding SkipForwardChoices}"
                SelectedItem="{Binding SkipForward, Mode=TwoWay}"
                AutomationProperties.Name="Skip forward by" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding VolumeStepText.Title}"
                         Description="{Binding VolumeStepText.Description}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Slider x:Name="VolumeStep"
                Theme="{StaticResource FlintSlider}"
                Minimum="1" Maximum="10" SmallChange="1" LargeChange="1"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding VolumeStep, Mode=TwoWay}"
                AutomationProperties.Name="Volume step" />
        <TextBlock Theme="{StaticResource BodyMedium}" VerticalAlignment="Center" MinWidth="36"
                   Text="{Binding VolumeStepLabel}" />
      </StackPanel>
    </controls:SettingRow>
    <TextBlock Theme="{StaticResource TitleLarge}" Text="The queue" Margin="0,24,0,4" />
    <controls:SettingRow Title="{Binding AutoPlayNextText.Title}"
                         Description="{Binding AutoPlayNextText.Description}">
      <ToggleSwitch x:Name="AutoPlayNext" Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                    AutomationProperties.Name="Play the next item automatically" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding RepeatText.Title}"
                         Description="{Binding RepeatText.Description}">
      <ComboBox x:Name="Repeat" Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding RepeatChoices}"
                SelectedItem="{Binding Repeat, Mode=TwoWay}"
                AutomationProperties.Name="Repeat" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding ShuffleText.Title}"
                         Description="{Binding ShuffleText.Description}">
      <ToggleSwitch x:Name="Shuffle" Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding Shuffle, Mode=TwoWay}"
                    AutomationProperties.Name="Shuffle" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding PictureText.Title}"
                         Description="{Binding PictureText.Description}">
      <ComboBox x:Name="PictureSeconds" Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding PictureChoices}"
                SelectedItem="{Binding PictureSeconds, Mode=TwoWay}"
                AutomationProperties.Name="Show each picture for" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding QueueEndText.Title}"
                         Description="{Binding QueueEndText.Description}">
      <ComboBox x:Name="QueueEnd" Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding QueueEndChoices}"
                SelectedItem="{Binding AtQueueEnd, Mode=TwoWay}"
                AutomationProperties.Name="When the queue ends" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding SubfoldersText.Title}"
                         Description="{Binding SubfoldersText.Description}">
      <ToggleSwitch x:Name="IncludeSubfolders" Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                    AutomationProperties.Name="Include subfolders when a folder is dropped" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding DropOrderText.Title}"
                         Description="{Binding DropOrderText.Description}">
      <ComboBox x:Name="DropOrder" Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding DropOrderChoices}"
                SelectedItem="{Binding DroppedOrder, Mode=TwoWay}"
                AutomationProperties.Name="Order of dropped files" />
    </controls:SettingRow>
    <TextBlock Theme="{StaticResource TitleLarge}" Text="Carrying on" Margin="0,24,0,4" />
    <controls:SettingRow Title="{Binding PlayedBeforeText.Title}"
                         Description="{Binding PlayedBeforeText.Description}">
      <ComboBox x:Name="PlayedBefore" Theme="{StaticResource FlintComboBox}"
                ItemsSource="{Binding PlayedBeforeChoices}"
                SelectedItem="{Binding PlayedBefore, Mode=TwoWay}"
                AutomationProperties.Name="When a file was played before" />
    </controls:SettingRow>
    <controls:SettingRow Title="{Binding RememberText.Title}"
                         Description="{Binding RememberText.Description}">
      <ToggleSwitch x:Name="RememberPlayback" Theme="{StaticResource FlintToggleSwitch}"
                    IsChecked="{Binding RememberPlayback, Mode=TwoWay}"
                    AutomationProperties.Name="Remember where files stopped" />
    </controls:SettingRow>
    <views:ConfirmableActionView DataContext="{Binding Reset}" Margin="0,18,0,0" />
  </StackPanel>
</UserControl>
