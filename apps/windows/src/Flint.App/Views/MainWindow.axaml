<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Flint.App.ViewModels"
        xmlns:views="using:Flint.App.Views"
        xmlns:controls="using:Flint.App.Controls"
        x:Class="Flint.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Flint — REX Technologies"
        Icon="avares://Flint.App/Assets/flint.ico"
        Width="1180" Height="780"
        MinWidth="{Binding MinimumWidth}" MinHeight="{Binding MinimumHeight}"
        Background="{StaticResource InkBrush}"
        FontFamily="{StaticResource FlintFont}">

  <LayoutTransformControl>
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding InterfaceScale}" ScaleY="{Binding InterfaceScale}" />
    </LayoutTransformControl.LayoutTransform>
  <Panel>
  <Grid ColumnDefinitions="220,*">

    <!-- The rail. Panel on ink, with a hairline separating it from the content. -->
    <Border Grid.Column="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <!-- Brand lockup: the bordered REX mark, the maker, then the product. -->
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,26" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}">
              <TextBlock Text="REX"
                         FontSize="10"
                         FontWeight="Black"
                         Foreground="{StaticResource SignalBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Theme="{StaticResource LabelSmall}"
                         Foreground="{StaticResource SignalBrush}"
                         Text="{x:Static vm:MainWindowViewModel.MakerName}" />
              <TextBlock Theme="{StaticResource TitleLarge}"
                         Text="{x:Static vm:MainWindowViewModel.ProductName}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Version, pinned to the foot of the rail. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18" Spacing="6">
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12" />
          <TextBlock Theme="{StaticResource LabelSmall}"
                     Text="{x:Static vm:MainWindowViewModel.VersionLabel}" />
          <TextBlock Theme="{StaticResource LabelSmall}" Text="{Binding PrivacyLabel}" />

          <!-- The walkthrough stays reachable; a first run is not the only time it is useful. -->
          <Button Theme="{StaticResource OutlineAction}"
                  Height="34"
                  Padding="12,0"
                  HorizontalAlignment="Left"
                  Margin="0,10,0,0"
                  Command="{Binding Onboarding.RestartCommand}"
                  Content="SHOW INTRODUCTION" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Destinations}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="12,0">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,10" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationDestination">
              <Grid>
                <TextBlock
                           Text="{Binding Label}"
                           Theme="{StaticResource TitleMedium}"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content, under a strip that says what the TV is showing when it is not this page's. -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top"
              IsVisible="{Binding ShowTvNotice}"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,0,0,1"
              Padding="24,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Theme="{StaticResource BodyMedium}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding TvNotice}"
                     AutomationProperties.Name="What the TV is showing" />
          <Button Grid.Column="1"
                  Theme="{StaticResource OutlineAction}"
                  Height="34"
                  Padding="12,0"
                  Margin="16,0,0,0"
                  Content="{Binding SwitchHereLabel}"
                  Command="{Binding SwitchHereCommand}"
                  IsVisible="{Binding CanSwitchHere}"
                  AutomationProperties.Name="Switch the TV to this page" />
        </Grid>
      </Border>

      <Panel>
        <views:CastPage DataContext="{Binding Cast}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsCastSelected}" />

        <views:DiagnosticsPage DataContext="{Binding Cast}"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDiagnosticsSelected}" />

        <views:MediaPage DataContext="{Binding Cast}"
                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsMediaSelected}" />

        <views:ScreenPage DataContext="{Binding Cast}"
              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsScreenSelected}" />

        <views:BrowserPage DataContext="{Binding Browser}"
                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsWebSelected}" />

        <views:SettingsPage DataContext="{Binding Settings}"
                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSettingsSelected}" />

        <ScrollViewer IsVisible="{Binding IsPlaceholderSelected}">
          <StackPanel Margin="{StaticResource PageMargin}" Spacing="12">
            <controls:PageHeading Eyebrow="Local tools"
                                  Title="{Binding SelectedLabel}"
                                  Trailing=""
                                  TrailingTone="Neutral" />
            <controls:EmptyState Glyph="—"
                                 Title="No tool connected"
                                 Body="This area is ready for a local receiver connection. Return to Cast to connect your Fire TV." />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>

  </Grid>

    <!--
      The introduction covers the shell entirely until it is completed or skipped. It carries the
      one fact that decides whether Flint can work at all, so it is not something to click past
      without noticing.
    -->
    <views:OnboardingView DataContext="{Binding Onboarding}"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Onboarding.IsVisible}" />

    <!--
      The switch question covers the shell until it is answered, and nothing on the TV changes while
      it is open. Focus moves to the switch button, so Enter or Space answers it once it is showing,
      though never an Enter still held from opening it; Escape keeps what the TV shows.
    -->
    <Border x:Name="SwitchOverlay"
            IsVisible="{Binding SwitchPrompt.IsOpen}"
            Background="#CC000000"
            KeyboardNavigation.TabNavigation="Cycle"
            KeyDown="OnSwitchOverlayKeyDown">
      <controls:InfoCard BorderTone="Signal"
                         MaxWidth="480"
                         Margin="24"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Theme="{StaticResource TitleMedium}"
                     TextWrapping="Wrap"
                     Text="{Binding SwitchPrompt.Title}" />
          <TextBlock Theme="{StaticResource BodyMedium}"
                     TextWrapping="Wrap"
                     Text="{Binding SwitchPrompt.Body}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SwitchConfirm"
                    Theme="{StaticResource SignalButton}"
                    Content="{Binding SwitchPrompt.ConfirmLabel}"
                    Command="{Binding SwitchPrompt.ConfirmCommand}"
                    AutomationProperties.Name="Switch the TV" />
            <Button Theme="{StaticResource OutlineAction}"
                    Content="{Binding SwitchPrompt.KeepLabel}"
                    Command="{Binding SwitchPrompt.KeepCommand}"
                    AutomationProperties.Name="Keep what the TV is showing" />
          </StackPanel>
        </StackPanel>
      </controls:InfoCard>
    </Border>
  </Panel>
  </LayoutTransformControl>
</Window>
