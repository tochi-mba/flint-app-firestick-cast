<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flint.App.ViewModels"
             xmlns:controls="using:Flint.App.Controls"
             x:Class="Flint.App.Views.CastPage"
             x:DataType="vm:CastPageViewModel">

  <ScrollViewer>
    <StackPanel Margin="{StaticResource PageMargin}" Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch">
      <controls:PageHeading Eyebrow="Your screens, together" Title="Connect to your TV"
                            Trailing="{Binding SessionStatus}" TrailingTone="{Binding HeadingTone}" />
      <TextBlock Theme="{StaticResource BodyMedium}" Text="Open Flint on your TV. Keep both devices on the same Wi-Fi or hotspot." />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Theme="{StaticResource SignalButton}" Command="{Binding ProbeCommand}"
                IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !HasDevice}"
                Content="FIND MY TV" AutomationProperties.Name="Find my TV" />
        <TextBlock Theme="{StaticResource BodySmall}" VerticalAlignment="Center"
                   IsVisible="{Binding IsProbing}" Text="Looking for your TV…" />
      </StackPanel>
      <controls:InfoCard IsVisible="{Binding HasDevice}" BorderTone="{Binding HeadingTone}">
        <StackPanel Spacing="16">
          <TextBlock Theme="{StaticResource TitleMedium}" Text="{Binding DeviceName}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsConnected}">
            <TextBlock Theme="{StaticResource BodyMedium}" VerticalAlignment="Center"
                       Text="Connected. Choose Screen, Media or Web to get started." />
            <Button Grid.Column="1" Theme="{StaticResource OutlineAction}"
                    Command="{Binding DisconnectCommand}"
                    Content="DISCONNECT"
                    AutomationProperties.Name="Disconnect from the TV" />
          </Grid>
          <StackPanel IsVisible="{Binding ShowPairing}" Spacing="10">
            <TextBlock Theme="{StaticResource BodyMedium}" Text="Enter the six-digit code on your TV." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto"
                  RowSpacing="4">
              <TextBlock Grid.Row="0" Grid.Column="0" Theme="{StaticResource LabelSmall}"
                         Foreground="{StaticResource MutedBrush}" Text="PAIRING CODE FROM TV" />
              <TextBox Grid.Row="1" Grid.Column="0"
                       Height="48"
                       Padding="12,0"
                       Background="{StaticResource RaisedBrush}"
                       Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource LineBrush}"
                       BorderThickness="1"
                       CornerRadius="{StaticResource RadiusSmall}"
                       PlaceholderText="Pairing code" MaxLength="6"
                       Text="{Binding PairingCode}"
                       AutomationProperties.Name="Pairing code" />
              <Button Grid.Row="1" Grid.Column="1"
                      Theme="{StaticResource SignalButton}"
                      Command="{Binding ConnectCommand}"
                      IsEnabled="{Binding CanPairWithCode}"
                      Content="CONNECT"
                      AutomationProperties.Name="Pair with TV" />
            </Grid>
            <TextBlock Theme="{StaticResource BodySmall}"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding PairingStatus}"
                       AutomationProperties.Name="Pairing status"
                       AutomationProperties.HelpText="{Binding PairingStatus}" />

          </StackPanel>
          <Expander Header="Set up or open Flint on this TV" IsExpanded="{Binding NeedsReceiverSetup, Mode=OneWay}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12" Margin="0,12,0,0">
                  <TextBlock Theme="{StaticResource BodySmall}"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding ReceiverSetupStatus}"
                       AutomationProperties.Name="Receiver setup status" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Theme="{StaticResource OutlineAction}"
                      HorizontalAlignment="Left"
                      Command="{Binding RunReceiverActionCommand}"
                      IsEnabled="{Binding CanRunReceiverAction}"
                      Content="{Binding ReceiverActionLabel}"
                      AutomationProperties.Name="Receiver action" />
                    <TextBlock Theme="{StaticResource BodySmall}"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}"
                         Text="{Binding InstallProgress}"
                         AutomationProperties.Name="Install progress" />
                  </StackPanel>

              <TextBlock Theme="{StaticResource BodySmall}"
                         Text="To remove Flint, open Settings → Applications → Manage Installed Applications on your TV, choose Flint, then Uninstall." />
            </StackPanel>
          </Expander>
        </StackPanel>
      </controls:InfoCard>
      <controls:InfoCard BorderTone="Live" IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <TextBlock Theme="{StaticResource TitleMedium}" Text="Couldn't connect" />
          <TextBlock Theme="{StaticResource BodyMedium}" Text="{Binding Failure}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </controls:InfoCard>
      <Expander Header="Can't find your TV?" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <TextBlock Theme="{StaticResource BodySmall}"
                     Text="Enter the TV address from Flint's Connection details, or Settings → My Fire TV → About → Network." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto"
                  RowSpacing="4">
              <!--
                Labels above the fields, not only inside them. A watermark disappears the moment a
                value exists, so a pre-filled or typed-in port becomes a bare number with nothing
                saying what it is.
              -->
              <TextBlock Grid.Row="0" Grid.Column="0" Theme="{StaticResource LabelSmall}"
                         Foreground="{StaticResource MutedBrush}" Text="TV IP ADDRESS" />
              <TextBox Grid.Row="1" Grid.Column="0"
                       Height="48"
                       Padding="12,0"
                       Background="{StaticResource RaisedBrush}"
                       Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource LineBrush}"
                       BorderThickness="1"
                       CornerRadius="{StaticResource RadiusSmall}"
                       PlaceholderText="Fire TV IP address"
                       AutomationProperties.Name="TV IP address"
                       Text="{Binding ManualAddress}" />
              <Button Grid.Row="1" Grid.Column="1"
                      Theme="{StaticResource OutlineAction}"
                      Command="{Binding ProbeAddressCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Content="CONNECT TO TV"
                      AutomationProperties.Name="Connect to TV" />
            </Grid>

          <Button Theme="{StaticResource OutlineAction}"
                  HorizontalAlignment="Left"
                  Command="{Binding ProbeCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Content="SEARCH THIS NETWORK AGAIN"
                  AutomationProperties.Name="Search this network again" />

          <Expander Header="Advanced connection settings" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8" Margin="0,12,0,0">
              <TextBlock Theme="{StaticResource BodySmall}" Text="Leave these unchanged unless your TV uses different ports." />
              <TextBlock Theme="{StaticResource LabelSmall}" Text="ADB PORT" />
              <TextBox Text="{Binding ManualPort}" PlaceholderText="Automatic" AutomationProperties.Name="ADB port" />
              <TextBlock Theme="{StaticResource LabelSmall}" Text="RECEIVER PORT" />
              <TextBox Text="{Binding ReceiverPort}" AutomationProperties.Name="Receiver port" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Expander>
      <Expander Header="Connection details and supported features" IsVisible="{Binding HasReport}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <TextBlock Theme="{StaticResource BodySmall}" Text="{Binding DeviceAddress}" />
          <TextBlock Theme="{StaticResource BodySmall}" Text="{Binding DevicePlatform}" />
      <ItemsControl ItemsSource="{Binding Modes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModeVerdictViewModel">
            <controls:InfoCard BorderTone="{Binding Tone}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Theme="{StaticResource TitleMedium}"
                             Text="{Binding Title}"
                             VerticalAlignment="Center" />
                  <controls:Pill Grid.Column="1"
                                 Text="{Binding StatusLabel}"
                                 Tone="{Binding Tone}" />
                </Grid>
                <TextBlock Theme="{StaticResource BodyMedium}"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding Reason}" />
                <!--
                  A mode that has not shipped gets a plan rather than a remedy. The "what to do"
                  block below is deliberately not reused for it: every instruction it could offer
                  would send someone looking for a setting that does not exist.
                -->
                <Border IsVisible="{Binding IsComingSoon}"
                        Background="{StaticResource RaisedBrush}"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="12,10">
                  <StackPanel Spacing="5">
                    <!--
                      Not "COMING SOON" again: the pill above already says that, and the panel's
                      job is to answer the question the pill provokes — whether the reader is
                      supposed to go and do something about it.
                    -->
                    <TextBlock Theme="{StaticResource LabelSmall}" Text="NO ACTION NEEDED" />
                    <TextBlock Theme="{StaticResource BodySmall}"
                               Foreground="{StaticResource TextBrush}"
                               Text="Nothing to change on your PC or your TV — this arrives in a Flint update." />
                  </StackPanel>
                </Border>
                <Border IsVisible="{Binding HasRemedy}"
                        Background="{StaticResource RaisedBrush}"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="12,10">
                  <StackPanel Spacing="5">
                    <TextBlock Theme="{StaticResource LabelSmall}" Text="WHAT TO DO" />
                    <TextBlock Theme="{StaticResource BodySmall}"
                               Foreground="{StaticResource TextBrush}"
                               Text="{Binding Remedy}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </controls:InfoCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
