<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Flint.App.Controls">

  <ControlTheme x:Key="FlintTextBox" TargetType="TextBox"
                BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <!-- Fluent paints hover and focus on the template's own border, in the system accent colour. -->
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
  </ControlTheme>

  <!-- One choice in a FlintComboBox's list. Fluent's own item theme highlights in the system accent. -->
  <ControlTheme x:Key="FlintComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    </Style>
  </ControlTheme>

  <!--
    Fluent paints hover, focus and disabled on the template's Background border, and draws its own
    focus rectangle; both are replaced here so the box reads as REX in every state.
  -->
  <ControlTheme x:Key="FlintComboBox" TargetType="ComboBox"
                BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FlintComboBoxItem}" />
    <!--
      The glyph's colour is set inside Fluent's template, which outranks a plain setter; only a
      state-triggered style outranks it, hence :not(:disabled). The content is a ContentControl.
    -->
    <Style Selector="^:not(:disabled) /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="^:not(:disabled) /template/ TextBlock#PlaceholderTextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:not(:disabled) /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^ /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:focus-visible /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource LineBrush}" />
    </Style>
  </ControlTheme>

  <!--
    On: a signal track with an ink knob. Off: a raised track with a muted knob. Focus is a ring
    outside the track, so it shows whether the switch is on or off: a focus border drawn on the
    track itself would be signal on signal, invisible exactly when the switch is on.
    Disabled keeps its contrast by losing its colour rather than fading it, for the reason the
    SignalButton theme gives: a dimmed accent still reads as live.
  -->
  <ControlTheme x:Key="FlintToggleSwitch" TargetType="ToggleSwitch">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <Border x:Name="FocusRing" Padding="2" CornerRadius="16" BorderThickness="2"
                  BorderBrush="Transparent">
            <Border x:Name="Track" Width="42" Height="24" CornerRadius="12"
                    Background="{StaticResource RaisedBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
              <Grid x:Name="PART_MovingKnobs">
                <Grid x:Name="PART_SwitchKnob" Width="16" Height="16" Margin="3"
                      HorizontalAlignment="Left">
                  <Ellipse x:Name="Thumb" Fill="{StaticResource MutedBrush}" />
                </Grid>
              </Grid>
            </Border>
          </Border>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Track">
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource SignalBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Grid#PART_SwitchKnob">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{StaticResource LineBrush}" />
    </Style>
  </ControlTheme>

  <!--
    A thin line track with the filled part in signal and a thumb large enough to grab. The thumb
    carries the focus ring, because that is where a keyboard user's arrow keys act.
  -->
  <ControlTheme x:Key="FlintSlider" TargetType="Slider">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid MinHeight="{TemplateBinding MinHeight}">
          <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                  Background="{TemplateBinding Background}" />
          <Track Name="PART_Track"
                 Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Focusable="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="{TemplateBinding Foreground}">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{TemplateBinding Background}" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Focusable="False" Background="Transparent"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb Name="thumb" Width="18" Height="18"
                   Background="{StaticResource TextBrush}"
                   BorderBrush="{StaticResource InkBrush}" BorderThickness="2">
              <Thumb.Template>
                <ControlTemplate>
                  <Border CornerRadius="9"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Thumb#thumb">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{StaticResource LineBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ Thumb#thumb">
      <Setter Property="Background" Value="{StaticResource MutedBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SettingRow}" TargetType="controls:SettingRow">
    <Setter Property="Padding" Value="0,14" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="{TemplateBinding Padding}">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Width="390" Margin="0,0,20,8" Spacing="4">
              <TextBlock Theme="{StaticResource TitleMedium}"
                         Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Theme="{StaticResource BodySmall}"
                         Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
            <ContentPresenter MinWidth="180"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </WrapPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    A button whose content is a layout rather than a label, such as a search result naming its
    section, title and explanation. OutlineAction draws its content as one upper-cased label, which
    turns a panel into its type name.
  -->
  <ControlTheme x:Key="ContentOutlineButton" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </ControlTheme>

  <!--
    One option of a SegmentedChoice. Its own theme, assigned as the list's ItemContainerTheme,
    because a ControlTheme may only style its own template: a "^ ListBoxItem" descendant selector
    inside the list's theme throws the moment the theme is loaded.
  -->
  <ControlTheme x:Key="SegmentedChoiceItem" TargetType="ListBoxItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    </Style>
    <!-- Focus thickens the ring rather than changing its colour, so it reads on a selected option too. -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="13,9" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SegmentedChoice}" TargetType="controls:SegmentedChoice">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedChoiceItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
