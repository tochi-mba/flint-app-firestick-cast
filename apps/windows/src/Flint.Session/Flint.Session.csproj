<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Flint.Session</RootNamespace>
    <Description>Low-latency Flint host-to-receiver session transport.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Flint.Core/Flint.Core.csproj" />
    <ProjectReference Include="../Flint.Protocol/Flint.Protocol.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Codec negotiation is the one piece of this class worth testing directly. It decides what the
      handshake promises, and a wrong answer there produces a blank television with a host that
      reports success, so it is held to tests rather than reached only through a live session.
    -->
    <InternalsVisibleTo Include="Flint.Session.Tests" />
  </ItemGroup>

</Project>
