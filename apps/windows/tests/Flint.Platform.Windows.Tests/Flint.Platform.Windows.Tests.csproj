    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Flint.Platform.Windows/Flint.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
